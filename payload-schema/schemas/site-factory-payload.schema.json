{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siteforge.io/schemas/v1/site-factory-payload.schema.json",
  "title": "SiteForgePayload",
  "description": "Canonical input specification for the SiteForge autonomous Angular web generation factory.",
  "type": "object",
  "required": ["version", "siteType", "designPreset", "theme", "integrations"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Payload contract schema version adhering to SemVer 1.x.x.",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "siteType": {
      "type": "string",
      "description": "Target website archetype governing component layouts and data models.",
      "enum": [
        "learning_platform",
        "blog",
        "newsletter",
        "ecommerce",
        "social_media",
        "landing_page"
      ]
    },
    "designPreset": {
      "type": "string",
      "description": "Design token preset mapped to Design.md master styling rules.",
      "enum": [
        "neo-brutalist",
        "clean-editorial",
        "modern-saas-dark",
        "warm-organic",
        "corporate-enterprise"
      ]
    },
    "designTokens": {
      "$ref": "#/$defs/DesignTokensOverride",
      "description": "Optional custom token overrides applied over the base preset."
    },
    "theme": {
      "$ref": "#/$defs/ThemeConfig",
      "description": "Brand identity, subject matter, and archetype-specific domain content."
    },
    "integrations": {
      "$ref": "#/$defs/IntegrationsConfig",
      "description": "GitHub repository and Vercel cloud project provisioning parameters."
    },
    "metadata": {
      "type": "object",
      "description": "Optional pipeline metadata, build hooks, or deployment annotations."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "siteType": { "const": "learning_platform" } },
        "required": ["siteType"]
      },
      "then": {
        "properties": {
          "theme": {
            "properties": {
              "content": { "$ref": "#/$defs/LearningPlatformContent" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "siteType": { "const": "blog" } },
        "required": ["siteType"]
      },
      "then": {
        "properties": {
          "theme": {
            "properties": {
              "content": { "$ref": "#/$defs/BlogContent" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "siteType": { "const": "newsletter" } },
        "required": ["siteType"]
      },
      "then": {
        "properties": {
          "theme": {
            "properties": {
              "content": { "$ref": "#/$defs/NewsletterContent" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "siteType": { "const": "ecommerce" } },
        "required": ["siteType"]
      },
      "then": {
        "properties": {
          "theme": {
            "properties": {
              "content": { "$ref": "#/$defs/EcommerceContent" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "siteType": { "const": "social_media" } },
        "required": ["siteType"]
      },
      "then": {
        "properties": {
          "theme": {
            "properties": {
              "content": { "$ref": "#/$defs/SocialMediaContent" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "siteType": { "const": "landing_page" } },
        "required": ["siteType"]
      },
      "then": {
        "properties": {
          "theme": {
            "properties": {
              "content": { "$ref": "#/$defs/LandingPageContent" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "HexColor": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "description": "Hexadecimal RGB color string (e.g. #FFF or #2D5A27)."
    },
    "ThemeBranding": {
      "type": "object",
      "properties": {
        "primaryColor": { "$ref": "#/$defs/HexColor" },
        "secondaryColor": { "$ref": "#/$defs/HexColor" },
        "fontHeading": { "type": "string", "minLength": 1 },
        "fontBody": { "type": "string", "minLength": 1 },
        "logoUrl": { "type": "string", "minLength": 1 },
        "faviconUrl": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "ThemeConfig": {
      "type": "object",
      "required": ["topic", "name", "tagline", "description", "content"],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Subject matter or domain topic."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Commercial name of the web application."
        },
        "tagline": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150,
          "description": "Marketing punchline or slogan."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500,
          "description": "Longer introductory summary."
        },
        "branding": { "$ref": "#/$defs/ThemeBranding" },
        "content": {
          "type": "object",
          "description": "Domain data entity collections."
        }
      }
    },
    "GitHubIntegration": {
      "type": "object",
      "required": ["repoName"],
      "properties": {
        "repoName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9._-]+$",
          "description": "Target repository name on GitHub."
        },
        "owner": { "type": "string", "minLength": 1 },
        "isPrivate": { "type": "boolean", "default": false },
        "autoInit": { "type": "boolean", "default": true },
        "defaultBranch": { "type": "string", "default": "main" },
        "description": { "type": "string", "maxLength": 350 },
        "topics": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "VercelIntegration": {
      "type": "object",
      "required": ["projectName"],
      "properties": {
        "projectName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9-]+$",
          "description": "Vercel project name (lowercase letters, digits, and hyphens)."
        },
        "teamId": { "type": "string", "minLength": 1 },
        "framework": { "type": "string", "default": "angular" },
        "buildCommand": { "type": "string" },
        "outputDirectory": { "type": "string" },
        "envVariables": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "IntegrationsConfig": {
      "type": "object",
      "required": ["github", "vercel"],
      "properties": {
        "github": { "$ref": "#/$defs/GitHubIntegration" },
        "vercel": { "$ref": "#/$defs/VercelIntegration" }
      },
      "additionalProperties": false
    },
    "DesignTokensOverride": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "bg": { "$ref": "#/$defs/HexColor" },
            "surface": { "$ref": "#/$defs/HexColor" },
            "surfaceMuted": { "$ref": "#/$defs/HexColor" },
            "textMain": { "$ref": "#/$defs/HexColor" },
            "textMuted": { "$ref": "#/$defs/HexColor" },
            "primary": { "$ref": "#/$defs/HexColor" },
            "primaryHover": { "$ref": "#/$defs/HexColor" },
            "accent": { "$ref": "#/$defs/HexColor" },
            "border": { "$ref": "#/$defs/HexColor" }
          },
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "properties": {
            "fontHeading": { "type": "string" },
            "fontBody": { "type": "string" },
            "fontMono": { "type": "string" }
          },
          "additionalProperties": false
        },
        "radii": {
          "type": "object",
          "properties": {
            "radiusSm": { "type": "string" },
            "radiusMd": { "type": "string" },
            "radiusLg": { "type": "string" },
            "radiusPill": { "type": "string" }
          },
          "additionalProperties": false
        },
        "shadows": {
          "type": "object",
          "properties": {
            "shadowCard": { "type": "string" },
            "shadowAmbient": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "StatItem": {
      "type": "object",
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" }
      }
    },
    "TestimonialItem": {
      "type": "object",
      "required": ["quote", "author", "role"],
      "properties": {
        "quote": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "avatarUrl": { "type": "string" }
      }
    },
    "FaqItem": {
      "type": "object",
      "required": ["question", "answer"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 }
      }
    },
    "CourseModule": {
      "type": "object",
      "required": ["title", "duration"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      }
    },
    "CourseItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "instructor",
        "level",
        "duration",
        "lessonsCount",
        "rating",
        "studentsCount",
        "summary",
        "modules"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "instructor": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "minLength": 1 },
        "duration": { "type": "string", "minLength": 1 },
        "lessonsCount": { "type": "integer", "minimum": 1 },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "studentsCount": { "type": "integer", "minimum": 0 },
        "badge": { "type": "string" },
        "summary": { "type": "string", "minLength": 1 },
        "thumbnailUrl": { "type": "string" },
        "modules": {
          "type": "array",
          "items": { "$ref": "#/$defs/CourseModule" },
          "minItems": 1
        }
      }
    },
    "LearningPlatformContent": {
      "type": "object",
      "required": ["featuredCategories", "courses"],
      "properties": {
        "featuredCategories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "courses": {
          "type": "array",
          "items": { "$ref": "#/$defs/CourseItem" },
          "minItems": 1
        },
        "stats": {
          "type": "array",
          "items": { "$ref": "#/$defs/StatItem" }
        },
        "testimonials": {
          "type": "array",
          "items": { "$ref": "#/$defs/TestimonialItem" }
        },
        "faqs": {
          "type": "array",
          "items": { "$ref": "#/$defs/FaqItem" }
        }
      }
    },
    "BlogPostAuthor": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" }
      }
    },
    "BlogPostItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "slug",
        "author",
        "category",
        "publishedAt",
        "readingTime",
        "summary",
        "tags"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "author": { "$ref": "#/$defs/BlogPostAuthor" },
        "category": { "type": "string", "minLength": 1 },
        "publishedAt": { "type": "string", "minLength": 1 },
        "readingTime": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "contentMarkdown": { "type": "string" },
        "coverImage": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "featured": { "type": "boolean" }
      }
    },
    "BlogContent": {
      "type": "object",
      "required": ["categories", "posts"],
      "properties": {
        "categories": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "posts": {
          "type": "array",
          "items": { "$ref": "#/$defs/BlogPostItem" },
          "minItems": 1
        },
        "authors": {
          "type": "array",
          "items": { "$ref": "#/$defs/BlogPostAuthor" }
        },
        "featuredPostId": { "type": "string" },
        "newsletterCta": {
          "type": "object",
          "required": ["title", "description", "buttonText"],
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "buttonText": { "type": "string" }
          }
        }
      }
    },
    "NewsletterEdition": {
      "type": "object",
      "required": ["issueNumber", "title", "publishedAt", "summary", "highlights"],
      "properties": {
        "issueNumber": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "minLength": 1 }
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "publishedAt": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "highlights": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "readUrl": { "type": "string" }
      }
    },
    "NewsletterContent": {
      "type": "object",
      "required": ["cadence", "leadIn", "perks", "editions"],
      "properties": {
        "cadence": { "type": "string", "minLength": 1 },
        "subscriberCount": {
          "oneOf": [{ "type": "string" }, { "type": "number" }]
        },
        "leadIn": { "type": "string", "minLength": 1 },
        "perks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "editions": {
          "type": "array",
          "items": { "$ref": "#/$defs/NewsletterEdition" },
          "minItems": 1
        },
        "testimonials": {
          "type": "array",
          "items": { "$ref": "#/$defs/TestimonialItem" }
        },
        "sampleIssue": {
          "type": "object",
          "required": ["title", "snippet"],
          "properties": {
            "title": { "type": "string" },
            "snippet": { "type": "string" }
          }
        }
      }
    },
    "ProductItem": {
      "type": "object",
      "required": ["id", "name", "slug", "price", "collection", "description", "inStock", "images"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "price": { "type": "number", "minimum": 0 },
        "compareAtPrice": { "type": "number", "minimum": 0 },
        "collection": { "type": "string", "minLength": 1 },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "reviewsCount": { "type": "integer", "minimum": 0 },
        "badge": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inStock": { "type": "boolean" },
        "images": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "sku": { "type": "string" }
      }
    },
    "EcommerceContent": {
      "type": "object",
      "required": ["currency", "collections", "products"],
      "properties": {
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "currencySymbol": { "type": "string" },
        "collections": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "products": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProductItem" },
          "minItems": 1
        },
        "shippingHighlights": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "description"],
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" },
              "icon": { "type": "string" }
            }
          }
        },
        "promotionalBanner": {
          "type": "object",
          "required": ["headline"],
          "properties": {
            "headline": { "type": "string" },
            "code": { "type": "string" },
            "discount": { "type": "string" }
          }
        },
        "reviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/TestimonialItem" }
        }
      }
    },
    "FeedPost": {
      "type": "object",
      "required": ["id", "author", "content", "timestamp", "likesCount", "repliesCount", "sharesCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "author": {
          "type": "object",
          "required": ["name", "handle"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "handle": { "type": "string", "pattern": "^@?[a-zA-Z0-9_]+$" },
            "avatarUrl": { "type": "string" },
            "verified": { "type": "boolean" }
          }
        },
        "content": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "minLength": 1 },
        "likesCount": { "type": "integer", "minimum": 0 },
        "repliesCount": { "type": "integer", "minimum": 0 },
        "sharesCount": { "type": "integer", "minimum": 0 },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mediaUrl": { "type": "string" }
      }
    },
    "SocialMediaContent": {
      "type": "object",
      "required": ["platformType", "trendingTopics", "feedPosts"],
      "properties": {
        "platformType": { "type": "string", "minLength": 1 },
        "trendingTopics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "feedPosts": {
          "type": "array",
          "items": { "$ref": "#/$defs/FeedPost" },
          "minItems": 1
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "membersCount", "description"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "membersCount": { "type": "integer", "minimum": 0 },
              "description": { "type": "string" },
              "icon": { "type": "string" }
            }
          }
        },
        "communityMetrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        }
      }
    },
    "HeroAction": {
      "type": "object",
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 }
      }
    },
    "LandingHero": {
      "type": "object",
      "required": ["headline", "subheadline", "primaryCta"],
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "subheadline": { "type": "string", "minLength": 1 },
        "primaryCta": { "$ref": "#/$defs/HeroAction" },
        "secondaryCta": { "$ref": "#/$defs/HeroAction" },
        "mediaUrl": { "type": "string" }
      }
    },
    "FeatureItem": {
      "type": "object",
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" }
      }
    },
    "PricingPlan": {
      "type": "object",
      "required": ["id", "name", "price", "billingPeriod", "features", "ctaLabel"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "price": { "type": "string", "minLength": 1 },
        "billingPeriod": { "type": "string", "minLength": 1 },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "isPopular": { "type": "boolean" },
        "ctaLabel": { "type": "string", "minLength": 1 }
      }
    },
    "LandingPageContent": {
      "type": "object",
      "required": ["hero", "features"],
      "properties": {
        "hero": { "$ref": "#/$defs/LandingHero" },
        "features": {
          "type": "array",
          "items": { "$ref": "#/$defs/FeatureItem" },
          "minItems": 1
        },
        "socialProof": {
          "type": "array",
          "items": { "$ref": "#/$defs/StatItem" }
        },
        "pricingPlans": {
          "type": "array",
          "items": { "$ref": "#/$defs/PricingPlan" }
        },
        "testimonials": {
          "type": "array",
          "items": { "$ref": "#/$defs/TestimonialItem" }
        },
        "faqs": {
          "type": "array",
          "items": { "$ref": "#/$defs/FaqItem" }
        },
        "ctaSection": {
          "type": "object",
          "required": ["title", "description", "buttonLabel"],
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "buttonLabel": { "type": "string" },
            "buttonHref": { "type": "string" }
          }
        }
      }
    }
  }
}
