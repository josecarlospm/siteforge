{
  "name": "@siteforge/payload-schema",
  "version": "1.0.0",
  "description": "SiteForge Canonical JSON Payload Schema, Zod Validators, and TypeScript Contracts",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./schema.json": "./schemas/site-factory-payload.schema.json",
    "./samples/*": "./samples/*"
  },
  "files": [
    "dist",
    "schemas",
    "samples"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "siteforge",
    "schema",
    "json-schema",
    "zod",
    "angular",
    "web-factory"
  ],
  "author": "SiteForge Engineering Team",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "tsx": "^4.19.3",
    "vitest": "^3.0.8"
  }
}
